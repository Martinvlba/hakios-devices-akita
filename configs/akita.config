# HakiOS fragment: the Pixel 8a (akita) -- what is true of this device and of no other.
# Every phone driver is left out until it has been made to work here; the arguments only those drivers read go too.
CONFIG_DEVICE="akita"
# CONFIG_HAKIOS_ADSP is not set
# CONFIG_HAKIOS_SPEAKER is not set
# CONFIG_HAKIOS_SOUND is not set
# CONFIG_HAKIOS_MIC is not set
# CONFIG_HAKIOS_BT is not set
# CONFIG_HAKIOS_CAMERA is not set
# CONFIG_HAKIOS_TORCH is not set
# CONFIG_HAKIOS_SOCINFO is not set
# CONFIG_HAKIOS_ADRENO is not set
# CONFIG_HAKIOS_HAPTIC is not set
# CONFIG_HAKIOS_GOODIX is not set
# CONFIG_HAKIOS_BUTTONS is not set
# CONFIG_HAKIOS_QMI is not set
# CONFIG_HAKIOS_MODEM is not set
# The battery's state for Darwin's power source (HakiosBattery), fed by the Pixel 8a's own reader below
CONFIG_HAKIOS_BATTERY=y
# CONFIG_HAKIOS_CPUFREQ is not set
# CONFIG_HAKIOS_THERMAL is not set
# CONFIG_HAKIOS_PMIC is not set
# CONFIG_HAKIOS_BATTGUARD is not set
# The phone's storage, through the loader (U-Boot's UFS driver has it up): ufs=2
CONFIG_HAKIOS_UFS=y
# CONFIG_HAKIOS_WIFI is not set
# CONFIG_TOUCHSCREEN is not set
# CONFIG_GPU is not set
# CONFIG_ADSP is not set
# CONFIG_SOUND is not set
# CONFIG_WIFI is not set
# CONFIG_MODEM is not set
# CONFIG_MODEM_AGAIN is not set
# CONFIG_FIRMWARE is "device" in the common kernel: say "none" here until this device's firmware is pulled
# HakiOS's U-Boot on zuma has no storage driver, so the loader has no block devices to serve. All nine cores
# (the kernel's MAX_CPUS, 16): the boot core and the others the kernel starts, from EL2 through the loader's trampoline;
# the ninth is the Cortex-X3 (BIG).
# CONFIG_UFS is not set
CONFIG_CPUS=9
# The keys: three pins of zuma's always-on pin controller, read only (devices/akita/drivers/input; buttons=1 turns it on)
CONFIG_HAKIOS_AKITA_KEYS=y
# The touch screen: a Goodix GT9895 on HSI0's USI2 SPI (devices/akita/drivers/input; touchscreen=1 turns it on, U-Boot powers it)
CONFIG_HAKIOS_AKITA_TOUCH=y
# The battery and charger state: the MAX77759 over zuma's hsi2c@10cb0000, read only (devices/akita/drivers/power; fuelgauge=1)
CONFIG_HAKIOS_AKITA_BATTERY=y
# The USB port as an iPhone's (step 1: enumeration and the mux interface's bulk endpoints; devices/akita/drivers/usb; usbmux=1)
CONFIG_HAKIOS_AKITA_USB=y
# ACPM, the power firmware, as a client (devices/akita/drivers/power): the thermal sensors now, DVFS later
CONFIG_HAKIOS_AKITA_ACPM=y
# The SoC's temperatures through ACPM, and the power-off stop (thermal=1; THERMAL, the Qualcomm one, stays out)
CONFIG_HAKIOS_AKITA_THERMAL=y
# The CPU clusters' clocks through ACPM, a governor and a thermal cap (devices/akita/drivers/power; dvfs=1)
CONFIG_HAKIOS_AKITA_DVFS=y
# The time of day from the PMIC's real-time clock (devices/akita/drivers/power), when epoch= does not give it
CONFIG_HAKIOS_AKITA_RTC=y
# Shut Down and Restart from iOS: power off and reset through PSCI (devices/akita/drivers/power)
CONFIG_HAKIOS_AKITA_POWER=y
# The GPU, a Mali-G715, woken step by step up to its firmware running (devices/akita/drivers/gpu; mali=N)
CONFIG_HAKIOS_AKITA_MALI=y
# The display pipeline: DECON0, DPP0 and the DPU's SysMMU read into the log (devices/akita/drivers/display; display_probe=1)
CONFIG_HAKIOS_AKITA_DISPLAY=y
# Wi-Fi: the Broadcom BCM4383 on PCIe channel 1, its link brought up step by step (devices/akita/drivers/wifi; pcie=N)
CONFIG_HAKIOS_AKITA_WIFI=y
# The flashlight: the LM3644 on zuma's hsi2c@10980000, for Control Center's button (devices/akita/drivers/camera; torch=3)
CONFIG_HAKIOS_AKITA_TORCH=y
# The vibration motor: the CS40L26A on zuma's hsi2c@10C80000 (devices/akita/drivers/haptic; haptic=1, a look so far)
CONFIG_HAKIOS_AKITA_HAPTIC=y
# The AoC (audio, sensors): Google's always-on DSP, started through the GSA's mailbox (devices/akita/drivers/aoc; aoc=1, a look)
CONFIG_HAKIOS_AKITA_AOC=y
# A client of Trusty, the secure-world OS: the GSA's AoC service is behind it (devices/akita/drivers/trusty; trusty=1, a look)
CONFIG_HAKIOS_AKITA_TRUSTY=y
# The speaker amplifiers: two CS35L41s on zuma's spi@111C0000, fed by the AoC's TDM_0 (devices/akita/drivers/audio; amp=1, a look)
CONFIG_HAKIOS_AKITA_AMP=y
# What works on the Pixel 8a, built into the kernel (the tester, 11-12: stable things on by default, what is not done
# behind an argument): each holds unless the command line names it, x=0 turns one off. Not here: what the loader reads
# (cpus, ufs, ufs_write, torch), the GPU's display arguments (bootrun's GPU=0 runs go without them), the vibration
# (haptic=5: every boot buzzes; on the flash's command line), identifiers. Sound since 11-12 (the speakers play through
# the AoC's audio_playback1, measured by the phone's own mics): the AoC, both CS35L41s without their protection DSP
# behind the kernel's guard (amp=2; amp=4's protection tuning makes the earpiece 18 dB louder and distort), at Android's
# analog gain -- speaker=0 on the command line keeps them silent (bootrun's QUIET=1: test boots with nobody there). The
# built-in microphone for iOS (aocrec=1: /dev/hakios-mic, the AoC listening only while an application records).
CONFIG_DEFAULTS="touchscreen=1 buttons=1 fuelgauge=1 usbmux=1 thermal=1 dvfs=1 mali_keep=1 metal=1 metal_plugin=../../../redwood/lib/HakiosMetal display_flip=1 root_apfs=ufs_darwin var_hfs=ufs_darwin_data pcie=5 pcie_delay=60 wifi=8 aoc=3 amp=2 speaker=1 amp_gain=17 aocrec=1"
