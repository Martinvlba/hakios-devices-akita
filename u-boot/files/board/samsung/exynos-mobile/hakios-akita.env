/*
 * HakiOS's U-Boot on the Pixel 8a (akita). No keys, no USB and no storage in U-Boot on zuma yet: nothing to choose with,
 * so it boots straight through. The loader and its payload come from the boot image's ramdisk (behind the vendor_boot
 * ramdisks Google's bootloader puts first: cmd/hakios.c finds the container); the screen is the only output.
 * When anything fails, what is in memory stays on the screen for a minute and the phone restarts, into Android.
 */
bootdelay=0
stdin=nulldev
stdout=vidconsole
stderr=vidconsole

/*
 * The panel (google-ak3b) runs in DSI command mode: it shows a frame only when DECON0 sends one, and Google's bootloader
 * leaves DECON0's TRIG_CON (0x19470030) masked after its splash: 0x3070, so nothing U-Boot draws would reach the panel.
 * 0x3061 unmasks the hardware trigger, and the panel is refreshed from the splash buffer (0xfac00000) at every TE again.
 * The value and the write are those found on the Pixel 8 Pro and 7 Pro (same DECON at the same address, the same
 * bootloader; derekross/omarchy-mobile, husky). Only that exact masked value is changed: anything else is left alone.
 */
preboot=if itest.l *0x19470030 == 0x3070; then mw.l 0x19470030 0x3061; echo "[oosexgang] display: DECON0 trigger unmasked"; \
	else echo "[oosexgang] display: DECON0 TRIG_CON is not 0x3070, left as it is"; md.l 0x19470030 1; fi; \
	hakios wdt; run hakios_usb

/*
 * USB, ready for the loader's own (xl) and for U-Boot's fastboot: the serial number the phone's bootloader shows (so that
 * a host set up for the phone takes this as the same device: Windows' usbipd sharing it into WSL), the eUSB repeater out
 * of its disabled state, the eUSB2 PHY out of reset (the bootloader leaves it in reset and IDDQ).
 */
hakios_usb=hakios serial; eusb repeater; eusb init

/*
 * The watchdogs of the two CPU clusters (watchdog_cl0@10060000, watchdog_cl1@10070000 in the phone's tree). Google's
 * bootloader leaves one counting for the kernel, which nothing here feeds yet: the phone restarted about two minutes
 * after every hand-over (117 and 121 s). `hakios wdt` (cmd/hakios.c) shows both and stops the ones counting.
 */
hakios_wdt=0x10060000 0x10070000
/* cl0 kept as a net, as slow as it goes: a hang restarts the phone by itself after about 2.5 minutes (measured) */
hakios_wdt_net=0x10060000

/*
 * The console kept in RAM over the restart (cmd/hakios.c, hakios_pstore): the pmsg zone of the phone's ramoops region
 * (ramoops_mem@fd3ff000: console 2 MiB, then pmsg 2 MiB; Google's bootloader writes its own log into the console
 * zone at every start). After the restart, in Android or recovery, as root:
 *   cat /sys/fs/pstore/pmsg-ramoops-0
 */
hakios_pstore=0xfd5ff000 0x200000

/*
 * USB: Google's bootloader turns the USB PHY off before it starts U-Boot (the DWC3's core reset then times out).
 * `eusb init` (cmd/hakios_eusb.c) brings it up again: the link control (ESS_CTL, phy@11100000's first range), the eUSB2
 * PHY's control (its second range) and the PHY's PMU register (system-controller@15460000 + pmu_offset 0x3eb0).
 */
hakios_eusb=0x11100000 0x11110000 0x15463eb0
/* the eUSB repeater: I2C bus 0 (i2c@10cb0000 in zuma-akita.dts), address 0x3e; the bootloader's timings of 0x10cb0000 kept */
hakios_eusb_repeater=0 0x3e 0x10cb0000

/*
 * ACPM (cmd/hakios_acpm.c): the APM's SRAM, the initdata's offset in it and the AP-APM mailbox (Android's tree: acpm_ipc,
 * reg 0x15110000 and 0x15700000, initdata-base 0xa000). The main PMIC (S2MPG14) is IPC channel 2, bus channel 0;
 * its regulators are access type 1: the USB PHY's LDO8M (0x44 bits 1:0), LDO9M (0x33 bits 7:6), LDO19M (0x3d bits 7:6).
 */
hakios_acpm=0x15700000 0xa000 0x15110000

/*
 * From the loader on, the console goes to pstore only: drawn on the screen line by line, the loader's copy of the kernel's
 * log at the end of a run took about five minutes (27 KB); in pstore it is all there after the restart. The kernel
 * draws its own screen. hakios_screen=1 keeps the screen as the console too.
 */
bootcmd=dcache; icache; if time hakios load; then if test "${hakios_screen}" != 1; then echo "[oosexgang] hakios: from the loader on, the console goes to pstore only (pmsg-ramoops-0)"; \
	setenv stdout pstore; setenv stderr pstore; fi; hakios boot; setenv stdout vidconsole,pstore; setenv stderr vidconsole,pstore; fi; \
	run hakios_failed
hakios_failed=echo; echo "HakiOS: the loader did not start (above); what is in memory:"; hakios info; \
	echo "restarting in 60 s"; sleep 60; reset
