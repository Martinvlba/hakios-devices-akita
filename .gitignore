# What devices/akita/pull-boot-info.sh pulls from the phone stays out: its properties, device tree and memory map carry
# the phone's own identifiers (serial, SoC id). The first-boot logs read back from pstore are kept.
boot-info/*
!boot-info/first-boot-*.txt
__pycache__/
# every private working note (handoff, todo lists, plans, crash catalogue): never in git
private-untracked/
