+	/*
+	 * UFS: the controller as Google's bootloader leaves it (enabled, the link up in HS gear 4 on two lanes; Android's tree:
+	 * ufs@13200000, samsung,exynos-ufs, fixed-prdt-req_list-ocs). Only its standard UFSHCI registers are named:
+	 * U-Boot takes it over as it is (drivers/ufs/ufs-hakios.c) and resets nothing.
+	 */
+	ufs@13200000 {
+		compatible = "hakios,ufs-handover";
+		reg = <0x0 0x13200000 0x0 0x200>;
