diff --git a/drivers/ufs/Kconfig b/drivers/ufs/Kconfig
index 49472933..10fe6c5a 100644
--- a/drivers/ufs/Kconfig
+++ b/drivers/ufs/Kconfig
@@ -8,6 +8,21 @@ config UFS
 	  This selects support for Universal Flash Subsystem (UFS).
 	  Say Y here if you want UFS Support.
 
+config UFS_HAKIOS_HANDOVER
+	bool "HakiOS: a UFS controller a bootloader left running, taken over as it is"
+	depends on UFS
+	help
+	  For a phone whose bootloader before U-Boot leaves the UFS link up and has no driver of U-Boot's for its PHY (the
+	  Pixel 8a, Google Tensor G3): the controller is not reset, the request lists are moved to U-Boot's memory, and
+	  PRDT entries are kept to 4 KB (compatible "hakios,ufs-handover").
+
+config UFS_EXYNOS_GS
+	bool "HakiOS: the UFS host of Google's Tensor G3 (zuma), brought up as Google's Linux driver does"
+	depends on UFS
+	help
+	  Samsung's UFS controller on Google's zuma (the Pixel 8a): a host reset, Samsung's CAL for the PHY and UniPro
+	  (drivers/ufs/exynos-gs, from Google's kernel), link startup (compatible "hakios,zuma-ufs").
+
 config UFS_AMD_VERSAL2
 	bool "AMD Versal Gen 2 UFS controller platform driver"
 	depends on UFS && ZYNQMP_FIRMWARE
