+#define UNIP_DME_DEEPSTALL_ENTER_REQ		0x7910
+#define UNIP_DME_DISCARD_CPORT_ID		0x7B24
+
+#define UNIP_DBG_FORCE_DME_CTRL_STATE		0x150
+#define UNIP_DBG_AUTO_DME_LINKSTARTUP		0x158
+#define UNIP_DBG_PA_CTRLSTATE			0x15C
+#define UNIP_DBG_PA_TX_STATE			0x160
+#define UNIP_DBG_BREAK_DME_CTRL_STATE		0x164
+#define UNIP_DBG_STEP_DME_CTRL_STATE		0x168
+#define UNIP_DBG_NEXT_DME_CTRL_STATE		0x16C
+
+/*
+ * UFS Protector registers
+ */
+#define UFSPRCTRL	0x000
+#define UFSPRSTAT	0x008
+#define UFSPRSECURITY	0x010
+ #define NSSMU		BIT(14)
+#define DESCTYPE(type)		((type & 0x3) << 19)
+#define ARPROTPRDT(type)	((type & 0x3) << 16)
+#define ARPROTDESC(type)	((type & 0x3) << 9)
+#define ARPROTDATA(type)	((type & 0x3) << 6)
+#define AWPROTDESC(type)	((type & 0x3) << 3)
+#define AWPROTDATA(type)	((type & 0x3))
+#define CFG_AXPROT(type)	(ARPROTPRDT(type) | ARPROTDESC(type) | \
+				ARPROTDATA(type) | AWPROTDESC(type) | \
+				AWPROTDATA(type))
+#define UFSPVERSION	0x01C
+#define UFSPRENCKEY0	0x020
+#define UFSPRENCKEY1	0x024
+#define UFSPRENCKEY2	0x028
+#define UFSPRENCKEY3	0x02C
+#define UFSPRENCKEY4	0x030
+#define UFSPRENCKEY5	0x034
+#define UFSPRENCKEY6	0x038
+#define UFSPRENCKEY7	0x03C
+#define UFSPRTWKEY0	0x040
+#define UFSPRTWKEY1	0x044
+#define UFSPRTWKEY2	0x048
+#define UFSPRTWKEY3	0x04C
+#define UFSPRTWKEY4	0x050
+#define UFSPRTWKEY5	0x054
+#define UFSPRTWKEY6	0x058
+#define UFSPRTWKEY7	0x05C
+#define UFSPWCTRL	0x100
+#define UFSPWSTAT	0x108
+#define UFSPWSECURITY	0x110
+#define UFSPWENCKEY0	0x120
+#define UFSPWENCKEY1	0x124
+#define UFSPWENCKEY2	0x128
+#define UFSPWENCKEY3	0x12C
+#define UFSPWENCKEY4	0x130
+#define UFSPWENCKEY5	0x134
+#define UFSPWENCKEY6	0x138
+#define UFSPWENCKEY7	0x13C
+#define UFSPWTWKEY0	0x140
+#define UFSPWTWKEY1	0x144
+#define UFSPWTWKEY2	0x148
+#define UFSPWTWKEY3	0x14C
+#define UFSPWTWKEY4	0x150
+#define UFSPWTWKEY5	0x154
+#define UFSPWTWKEY6	0x158
+#define UFSPWTWKEY7	0x15C
+#define UFSPSBEGIN0	0x200
+#define UFSPSEND0	0x204
+#define UFSPSLUN0	0x208
+#define UFSPSCTRL0	0x20C
+#define UFSPSBEGIN1	0x210
+#define UFSPSEND1	0x214
+#define UFSPSLUN1	0x218
+#define UFSPSCTRL1	0x21C
+#define UFSPSBEGIN2	0x220
+#define UFSPSEND2	0x224
+#define UFSPSLUN2	0x228
+#define UFSPSCTRL2	0x22C
+#define UFSPSBEGIN3	0x230
+#define UFSPSEND3	0x234
+#define UFSPSLUN3	0x238
+#define UFSPSCTRL3	0x23C
+#define UFSPSBEGIN4	0x240
+#define UFSPSEND4	0x244
+#define UFSPSLUN4	0x248
+#define UFSPSCTRL4	0x24C
+#define UFSPSBEGIN5	0x250
+#define UFSPSEND5	0x254
+#define UFSPSLUN5	0x258
+#define UFSPSCTRL5	0x25C
+#define UFSPSBEGIN6	0x260
+#define UFSPSEND6	0x264
+#define UFSPSLUN6	0x268
+#define UFSPSCTRL6	0x26C
+#define UFSPSBEGIN7	0x270
+#define UFSPSEND7	0x274
+#define UFSPSLUN7	0x278
+#define UFSPSCTRL7	0x27C
+
+#endif /* _UFS_VS_REGS_H_ */
diff --git a/drivers/ufs/ufs-exynos-gs.c b/drivers/ufs/ufs-exynos-gs.c
new file mode 100644
index 00000000..788d93a0
--- /dev/null
+++ b/drivers/ufs/ufs-exynos-gs.c
@@ -0,0 +1,277 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * HakiOS: the UFS host of Google's Tensor G3 (zuma; the Pixel 8a), brought up the way Google's Linux driver does it:
+ * google-modules/soc/gs drivers/ufs/ufs-exynos.c (android-gs-akita-6.1-android15-qpr2), with Samsung's CAL for the PHY
+ * and UniPro (exynos-gs/, as is). In U-Boot's terms: a UFS platform driver whose hooks do what Linux's do.
+ *
+ *   init            the register ranges; IO coherency (sysreg_ufs + 0x710); the PHY out of isolation (the PMU, through
+ *                   the secure monitor) if it is not; the CAL told what it needs (UniPro clock 178 MHz, board 1 as
+ *                   Android's tree has it, EVT 0, gear 4, 2 lanes)
+ *   hce_enable      before: the host's link and UniPro reset (HCI_SW_RST) and its configuration (exynos_ufs_config_host),
+ *                   then the device's reset pin (HCI_GPIO_OUT); after: the clock-stop controls, the lanes there are
+ *   link_startup    before: the error reporting, UniPro's debug suites, the CAL's pre_link; after: the lanes and gear the
+ *                   link came up with, the CAL's post_link
+ *
+ * What Linux also does and this does not: inline encryption (KDN, through the GSA), the power-mode change to HS gear 4
+ * (not yet: the link stays in PWM-G1, a few MB/s), clock gating and hibernation.
+ *
+ * Found on the phone (2026-11-01): the bootloader hands over with the link up, but the controller does not take a
+ * request without the reset and bring-up above (the port's log 4).
+ */
+#include <dm.h>
+#include <time.h>
+#include <ufs.h>
+#include <asm/io.h>
+#include <dm/device_compat.h>
+#include <linux/arm-smccc.h>
+#include <linux/bitops.h>
+#include <linux/delay.h>
+#include <linux/errno.h>
+#include "ufs.h"
+#include "unipro.h"
+#include "exynos-gs/ufs-vs-mmio.h"
+#include "exynos-gs/ufs-vs-regs.h"
+#include "exynos-gs/ufs-cal-if.h"
+
+#define TENSOR_SMC_PMU_SEC_REG		0x82000504
+#define TENSOR_PMUREG_READ		0
+#define TENSOR_PMUREG_RMW		2
+#define SMC_CMD_SMU			0xc2001850
+#define SMU_INIT			0
+#define SMU_EMBEDDED			0
+
+#define UNIP_PA_DBG_OPTION_SUITE_1	0x39A8
+#define DBG_SUITE1_ENABLE		0x90913C1C
+#define UNIP_PA_DBG_OPTION_SUITE_2	0x39B4
+#define DBG_SUITE2_ENABLE		0xE01C115F
+
+struct ufs_exynos_gs {
+	struct ufs_vs_handle handle;
+	struct ufs_cal_param cal;
+	struct uic_pwr_mode pmd;
+	void __iomem *sysreg;
+	ulong pmu_phy_iso;
+	u32 mclk_rate;
+	u32 lanes;
+};
+
+static void ufs_gs_udelay(u32 us)
+{
+	udelay(us);
+}
+
+static struct ufs_exynos_gs *gs_of(struct ufs_hba *hba)
+{
+	return dev_get_priv(hba->dev);
+}
+
+static int ufs_gs_cal(struct ufs_exynos_gs *gs, enum ufs_cal_errno (*fn)(struct ufs_cal_param *), const char *what)
+{
+	enum ufs_cal_errno r;
+	u32 reg;
+
+	/* the PHY's APB clock let run around the CAL (Linux's ufs_call_cal) */
+	reg = hci_readl(&gs->handle, HCI_FORCE_HCS);
+	hci_writel(&gs->handle, reg & ~(UNIPRO_MCLK_STOP_EN | MPHY_APBCLK_STOP_EN), HCI_FORCE_HCS);
+	r = fn(&gs->cal);
+	reg = hci_readl(&gs->handle, HCI_FORCE_HCS);
+	hci_writel(&gs->handle, reg | MPHY_APBCLK_STOP_EN, HCI_FORCE_HCS);
+	printf("UFS: CAL %s: %d\n", what, r);
+	return r == UFS_CAL_NO_ERROR ? 0 : -EIO;
+}
+
+static int ufs_gs_init(struct ufs_hba *hba)
+{
+	struct ufs_exynos_gs *gs = gs_of(hba);
+	struct udevice *dev = hba->dev;
+	struct arm_smccc_res res;
+	u32 w[4];
+	int i;
+
+	gs->handle.std = hba->mmio_base;
+	for (i = 1; i <= 5; i++) {
+		void __iomem *p = dev_remap_addr_index(dev, i);
+
+		if (!p) {
+			dev_err(dev, "UFS: no register range %d\n", i);
+			return -EINVAL;
+		}
+		switch (i) {
+		case 1: gs->handle.hci = p; break;
+		case 2: gs->handle.unipro = p; break;
+		case 3: gs->handle.ufsp = p; break;
+		case 4: gs->handle.pma = p; break;
+		case 5: gs->handle.cport = p; break;
+		}
+	}
+	gs->handle.udelay = ufs_gs_udelay;
+	gs->handle.private = gs;
+
+	/*
+	 * Google's bootloader switches the UFS device off before it hands over: its supply (Android's tree: ufs-vcc, a
+	 * fixed regulator on gpp0-1) low, and its reference clock pin (gph5-0, ufs-refclk-out) made a GPIO driven low. The
+	 * controller's registers still say the link is up. Both are put back as Android has them:
+	 *   hakios,vcc-gpio = <CON PIN>         a Samsung GPIO (CON register, DAT at +4) made an output, high
+	 *   hakios,pinmux = <ADDR MASK VALUE>... registers read, MASK cleared, VALUE set
+	 */
+	if (!dev_read_u32_array(dev, "hakios,vcc-gpio", w, 2)) {
+		void __iomem *con = (void __iomem *)(uintptr_t)w[0];
+
+		writel(readl(con + 4) | BIT(w[1]), con + 4);
+		writel((readl(con) & ~(0xf << (4 * w[1]))) | (1 << (4 * w[1])), con);
+		printf("UFS: the device's supply on (GPIO %#x pin %u)\n", w[0], w[1]);
+	}
+	for (i = 0; ; i += 3) {
+		u32 m[3];
+		void __iomem *a;
+
+		if (dev_read_u32_index(dev, "hakios,pinmux", i, &m[0]) ||
+		    dev_read_u32_index(dev, "hakios,pinmux", i + 1, &m[1]) ||
+		    dev_read_u32_index(dev, "hakios,pinmux", i + 2, &m[2]))
+			break;
+		a = (void __iomem *)(uintptr_t)m[0];
+		writel((readl(a) & ~m[1]) | m[2], a);
+	}
+	mdelay(10);
+
+	/* IO coherency, as Linux sets it for 'dma-coherent' (Android's tree: ufs-iocc, sysreg_ufs 0x710 mask 3 val 3) */
+	gs->sysreg = (void __iomem *)(uintptr_t)dev_read_u32_default(dev, "hakios,sysreg", 0);
+	if (gs->sysreg)
+		writel(readl(gs->sysreg + 0x710) | 0x3, gs->sysreg + 0x710);
+
+	/* the PHY out of isolation (Android's tree: ufs-phy-iso, PMU + 0x3ec0 bit 0), if the bootloader has not */
+	gs->pmu_phy_iso = dev_read_u32_default(dev, "hakios,pmu-phy-iso", 0);
+	if (gs->pmu_phy_iso) {
+		arm_smccc_smc(TENSOR_SMC_PMU_SEC_REG, gs->pmu_phy_iso, TENSOR_PMUREG_READ, 0, 0, 0, 0, 0, &res);
+		printf("UFS: PHY isolation register %#lx = %#lx\n", gs->pmu_phy_iso, res.a0);
+		if (!(res.a0 & 1))
+			arm_smccc_smc(TENSOR_SMC_PMU_SEC_REG, gs->pmu_phy_iso, TENSOR_PMUREG_RMW, 1, 1, 0, 0, 0, &res);
+	}
+
+	/* the UFS protector as Linux starts it (no FMP descriptors: they would change the PRDT entry size) */
+	arm_smccc_smc(SMC_CMD_SMU, SMU_INIT, SMU_EMBEDDED, 0, 0, 0, 0, 0, &res);
+	printf("UFS: SMC_CMD_SMU(SMU_INIT): %ld\n", (long)res.a0);
+
+	hba->quirks |= UFSHCD_QUIRK_HAKIOS_PRDT_4K | UFSHCD_QUIRK_HAKIOS_EXYNOS_NEXUS;
+	if (!dev_read_u32_array(dev, "hakios,dma-window", w, 4)) {
+		hba->hakios_dma = (void *)(uintptr_t)(((u64)w[0] << 32) | w[1]);
+		hba->hakios_dma_size = ((u64)w[2] << 32) | w[3];
+	}
+
+	gs->mclk_rate = dev_read_u32_default(dev, "hakios,mclk-rate", 178000000);
+	gs->pmd.gear = dev_read_u32_default(dev, "hakios,gear", 4);
+	gs->pmd.lane = dev_read_u32_default(dev, "hakios,lanes", 2);
+	gs->cal.handle = &gs->handle;
+	gs->cal.board = dev_read_u32_default(dev, "hakios,cal-board", 1);
+	gs->cal.evt_ver = 0;
+	gs->cal.tbl = HOST_EMBD;
+	gs->cal.max_gear = gs->pmd.gear;
+	gs->cal.mclk_rate = gs->mclk_rate;
+	return ufs_cal_init(&gs->cal, 0) == UFS_CAL_NO_ERROR ? 0 : -EIO;
+}
+
+/* Linux's exynos_ufs_config_host() */
+static void ufs_gs_config_host(struct ufs_exynos_gs *gs)
+{
+	struct ufs_vs_handle *h = &gs->handle;
+
+	hci_writel(h, hci_readl(h, HCI_FORCE_HCS) & ~HCI_CORECLK_STOP_EN, HCI_FORCE_HCS);
+	hci_writel(h, hci_readl(h, HCI_UFSHCI_V2P1_CTRL) | IA_TICK_SEL, HCI_UFSHCI_V2P1_CTRL);
+	hci_writel(h, (gs->mclk_rate / 1000000) & CNT_VAL_1US_MASK, HCI_1US_TO_CNT_VAL);
+	hci_writel(h, 0xA, HCI_DATA_REORDER);
+	hci_writel(h, PRDT_PREFECT_EN | PRDT_SET_SIZE(12), HCI_TXPRDT_ENTRY_SIZE);
+	hci_writel(h, PRDT_SET_SIZE(12), HCI_RXPRDT_ENTRY_SIZE);
+	hci_writel(h, 0xFFFFFFFF, HCI_UTRL_NEXUS_TYPE);
+	hci_writel(h, 0xFFFFFFFF, HCI_UTMRL_NEXUS_TYPE);
+	hci_writel(h, WLU_EN | BURST_LEN(3), HCI_AXIDMA_RWDATA_BURST_LEN);
+	hci_writel(h, hci_readl(h, HCI_IOP_ACG_DISABLE) & ~HCI_IOP_ACG_DISABLE_EN, HCI_IOP_ACG_DISABLE);
+	unipro_writel(h, DBG_SUITE1_ENABLE, UNIP_PA_DBG_OPTION_SUITE_1);
+	unipro_writel(h, DBG_SUITE2_ENABLE, UNIP_PA_DBG_OPTION_SUITE_2);
+	hci_writel(h, hci_readl(h, HCI_VENDOR_SPECIFIC_IE) | AH8_ERR_REPORT_UE, HCI_VENDOR_SPECIFIC_IE);
+}
+
+static int ufs_gs_hce_enable_notify(struct ufs_hba *hba, enum ufs_notify_change_status status)
+{
+	struct ufs_exynos_gs *gs = gs_of(hba);
+	struct ufs_vs_handle *h = &gs->handle;
+	ulong start;
+
+	if (status == PRE_CHANGE) {
+		/* host reset (Linux's exynos_ufs_init_host), then its configuration */
+		hci_writel(h, UFS_SW_RST_MASK, HCI_SW_RST);
+		start = timer_get_us();
+		while (hci_readl(h, HCI_SW_RST) & UFS_SW_RST_MASK) {
+			if (timer_get_us() - start > 1000) {
+				dev_err(hba->dev, "UFS: host reset does not complete\n");
+				return -ETIMEDOUT;
+			}
+		}
+		ufs_gs_config_host(gs);
+		/* the device's reset (Linux's exynos_ufs_dev_hw_reset) */
+		hci_writel(h, 0, HCI_GPIO_OUT);
+		udelay(5);
+		hci_writel(h, 1, HCI_GPIO_OUT);
+		return 0;
+	}
+	/* POST_CHANGE: clock-stop controls as Linux leaves them, and the lanes the host has */
+	hci_writel(h, hci_readl(h, HCI_FORCE_HCS) | CLK_STOP_CTRL_EN_ALL, HCI_FORCE_HCS);
+	hci_writel(h, hci_readl(h, HCI_CLKSTOP_CTRL) & ~CLK_STOP_ALL, HCI_CLKSTOP_CTRL);
+	gs->lanes = unipro_readl(h, UNIP_PA_AVAILRXDATALENS);
+	printf("UFS: host reset and configured; %u lanes (tx %u)\n", gs->lanes,
+	       unipro_readl(h, UNIP_PA_AVAILTXDATALENS));
+	return gs->lanes ? 0 : -ENODEV;
+}
+
+static int ufs_gs_link_startup_notify(struct ufs_hba *hba, enum ufs_notify_change_status status)
+{
+	struct ufs_exynos_gs *gs = gs_of(hba);
+	struct ufs_vs_handle *h = &gs->handle;
+	u32 tx, rx, gear;
+
+	if (status == PRE_CHANGE) {
+		hci_writel(h, DFES_ERR_EN | DFES_DEF_DL_ERRS, HCI_ERROR_EN_DL_LAYER);
+		hci_writel(h, DFES_ERR_EN | DFES_DEF_N_ERRS, HCI_ERROR_EN_N_LAYER);
+		hci_writel(h, DFES_ERR_EN | DFES_DEF_T_ERRS, HCI_ERROR_EN_T_LAYER);
+		unipro_writel(h, DBG_SUITE1_ENABLE, UNIP_PA_DBG_OPTION_SUITE_1);
+		unipro_writel(h, DBG_SUITE2_ENABLE, UNIP_PA_DBG_OPTION_SUITE_2);
+		gs->cal.mclk_rate = gs->mclk_rate;
+		gs->cal.available_lane = gs->lanes;
+		return ufs_gs_cal(gs, ufs_cal_pre_link, "pre_link");
+	}
+	tx = unipro_readl(h, UNIP_PA_CONNECTEDTXDATALANES);
+	rx = unipro_readl(h, UNIP_PA_CONNECTEDRXDATALANES);
+	gear = unipro_readl(h, UNIP_PA_MAXRXHSGEAR);
+	printf("UFS: link up: %u/%u lanes connected, the device up to HS gear %u\n", tx, rx, gear);
+	gs->cal.connected_tx_lane = rx;
+	gs->cal.connected_rx_lane = rx;
+	gs->cal.max_gear = min_t(u8, gear, gs->pmd.gear);
+	return ufs_gs_cal(gs, ufs_cal_post_link, "post_link");
+}
+
+static struct ufs_hba_ops ufs_gs_ops = {
+	.init			= ufs_gs_init,
+	.hce_enable_notify	= ufs_gs_hce_enable_notify,
+	.link_startup_notify	= ufs_gs_link_startup_notify,
+};
+
+static int ufs_gs_probe(struct udevice *dev)
+{
+	int err = ufshcd_probe(dev, &ufs_gs_ops);
+
+	if (err)
+		dev_err(dev, "UFS: no storage: %d\n", err);
+	return err;
+}
+
+static const struct udevice_id ufs_gs_ids[] = {
+	{ .compatible = "hakios,zuma-ufs" },
+	{ }
+};
+
+U_BOOT_DRIVER(ufs_exynos_gs) = {
+	.name		= "ufs-exynos-gs",
+	.id		= UCLASS_UFS,
+	.of_match	= ufs_gs_ids,
+	.probe		= ufs_gs_probe,
+	.priv_auto	= sizeof(struct ufs_exynos_gs),
+};
diff --git a/drivers/ufs/ufs-hakios.c b/drivers/ufs/ufs-hakios.c
new file mode 100644
index 00000000..0bfb95da
--- /dev/null
+++ b/drivers/ufs/ufs-hakios.c
@@ -0,0 +1,76 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * HakiOS: a UFS host controller that a bootloader before U-Boot left running, taken over as it is (the Pixel 8a,
+ * Google Tensor G3 "zuma": Samsung's UFSHCI 3.0 with the link up in HS gear 4 on two lanes). Nothing of the controller,
+ * its PHY or the device is reset or reconfigured; U-Boot's UFS core moves the request lists to its own memory and goes
+ * on from there (UFSHCD_QUIRK_HAKIOS_KEEP_LINK), with PRDT entries of 4 KB as the Exynos HCI is set up for
+ * (UFSHCD_QUIRK_HAKIOS_PRDT_4K). Found so on the phone: HCE 1, HCS 0x10f, the bootloader's lists running at 0xf8c42000.
+ *
+ * zuma's controller is a standard UFSHCI in what this uses: Android's tree has fixed-prdt-req_list-ocs, with which
+ * Google's driver drops the Exynos quirks (PRDT_BYTE_GRAN and the rest), and the bootloader's own descriptors use
+ * dword offsets and 16-byte PRDT entries (no FMP descriptors).
+ *
+ *	ufs@13200000 { compatible = "hakios,ufs-handover"; reg = <0x0 0x13200000 0x0 0x200>; };
+ */
+#include <dm.h>
+#include <ufs.h>
+#include <dm/device_compat.h>
+#include <linux/arm-smccc.h>
+#include "ufs.h"
+
+/*
+ * The UFS protector's SMU (Samsung's "UFSPR", which decides what memory a UFS transfer may touch) as Google's driver
+ * starts it at every boot, through the secure monitor: SMC_CMD_SMU(SMU_INIT, SMU_EMBEDDED). Not SMC_CMD_FMP_SECURITY
+ * with descriptor type 3: that turns PRDT entries into FMP's 128-byte ones, and the bootloader's are the 16-byte ones.
+ */
+#define SMC_CMD_SMU		0xc2001850
+#define SMU_INIT		0
+#define SMU_EMBEDDED		0
+
+static int ufs_hakios_init(struct ufs_hba *hba)
+{
+	struct arm_smccc_res res;
+	u32 w[4];
+
+	hba->quirks |= UFSHCD_QUIRK_HAKIOS_KEEP_LINK | UFSHCD_QUIRK_HAKIOS_PRDT_4K;
+	if (dev_read_bool(hba->dev, "hakios,smu-init")) {
+		arm_smccc_smc(SMC_CMD_SMU, SMU_INIT, SMU_EMBEDDED, 0, 0, 0, 0, 0, &res);
+		printf("UFS: SMC_CMD_SMU(SMU_INIT): %ld\n", (long)res.a0);
+	}
+	/*
+	 * hakios,dma-window = <base-hi base-lo size-hi size-lo>: the memory the controller may reach. On the Pixel 8a an
+	 * S2MPU in front of HSI2 (s2mpu_s0_hsi2@131f0000, always on) lets it reach what Google's bootloader used for its own
+	 * UFS lists and no more (a request in U-Boot's memory was never fetched: the doorbell stayed set, no completion,
